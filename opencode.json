{
    "$schema":  "https://opencode.ai/config.json",
    "model":  "ollama/qwen2.5-coder:7b",
    "small_model":  "ollama/gemma3:4b",
    "default_agent":  "build",
    "instructions":  [
                         "AGENTS.md",
                         "prompts/system.md"
                     ],
    "provider":  {
                     "ollama":  {
                                    "options":  {
                                                    "baseURL":  "http://localhost:11434/v1",
                                                    "apiKey":  "ollama",
                                                    "timeout":  false,
                                                    "headerTimeout":  false
                                                },
                                    "models":  {
                                                   "qwen2.5-coder:7b":  {
                                                                            "name":  "Qwen2.5 Coder 7B",
                                                                            "limit":  {
                                                                                          "context":  32768,
                                                                                          "output":  8192
                                                                                      },
                                                                            "modalities":  {
                                                                                               "input":  [
                                                                                                             "text"
                                                                                                         ],
                                                                                               "output":  [
                                                                                                              "text"
                                                                                                          ]
                                                                                           },
                                                                            "tool_call":  true
                                                                        },
                                                    "nemotron-3.5-lightning:30b-a3b-q4_K_M":  {
                                                                             "name":  "Nemotron 3.5 Lightning 30B-A3B",
                                                                             "limit":  {
                                                                                           "context":  16384,
                                                                                           "output":  8192
                                                                                       },
                                                                             "modalities":  {
                                                                                                "input":  [
                                                                                                              "text"
                                                                                                          ],
                                                                                                "output":  [
                                                                                                               "text"
                                                                                                           ]
                                                                                            },
                                                                             "tool_call":  true,
                                                                             "reasoning":  true
                                                                         },
                                                    "deepseek-r1:7b":  {
                                                                          "name":  "DeepSeek R1 7B",
                                                                          "limit":  {
                                                                                        "context":  32768,
                                                                                        "output":  8192
                                                                                    },
                                                                          "modalities":  {
                                                                                             "input":  [
                                                                                                           "text"
                                                                                                       ],
                                                                                             "output":  [
                                                                                                            "text"
                                                                                                        ]
                                                                                         },
                                                                          "reasoning":  true
                                                                      },
                                                   "llama3.1:8b":  {
                                                                       "name":  "Llama 3.1 8B",
                                                                       "limit":  {
                                                                                     "context":  32768,
                                                                                     "output":  8192
                                                                                 },
                                                                       "modalities":  {
                                                                                          "input":  [
                                                                                                        "text"
                                                                                                    ],
                                                                                          "output":  [
                                                                                                         "text"
                                                                                                     ]
                                                                                      },
                                                                       "tool_call":  true
                                                                   },
                                                   "gemma3:4b":  {
                                                                     "name":  "Gemma 3 4B",
                                                                     "limit":  {
                                                                                   "context":  8192,
                                                                                   "output":  4096
                                                                               },
                                                                     "modalities":  {
                                                                                        "input":  [
                                                                                                      "text"
                                                                                                  ],
                                                                                        "output":  [
                                                                                                       "text"
                                                                                                   ]
                                                                                    }
                                                                 }
                                               }
                                }
                 },
    "agent":  {
                  "build":  {
                                "description":  "Primary coding agent - optimized for 6GB VRAM",
                                "mode":  "primary",
                                "model":  "ollama/qwen2.5-coder:7b",
                                "temperature":  0.2
                            },
                  "planner":  {
                                  "description":  "Advanced reasoning and structure planning - NVIDIA Nemotron 3.5 Lightning MoE",
                                  "mode":  "subagent",
                                  "model":  "ollama/nemotron-3.5-lightning:30b-a3b-q4_K_M",
                                  "temperature":  0.6
                              },
                  "coder":  {
                                "description":  "Specialized code generation and compilation - use for writing, refactoring, and building advanced code",
                                "mode":  "subagent",
                                "model":  "ollama/qwen2.5-coder:7b",
                                "temperature":  0.2
                            },
                  "reviewer":  {
                                   "description":  "Verification, testing, and data validation - use for compile checks, lint, and review",
                                   "mode":  "subagent",
                                   "model":  "ollama/llama3.1:8b",
                                   "temperature":  0.1
                               }
              },
    "permission":  {
                       "bash":  "allow",
                       "edit":  "allow",
                       "external_directory":  "allow"
                   }
}
