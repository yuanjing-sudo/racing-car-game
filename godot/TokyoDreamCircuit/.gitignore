# Godot's cache. Everything in here is generated and large; the editor rebuilds
# it on demand. This is the only folder Godot 4 itself asks you to ignore.
.godot/

# Generated by the Android build template.
/android/

# Export presets can contain keystore paths and passwords, so they are treated as
# local machine config rather than source. Recreate them from the README.
export_presets.cfg

# Exported builds
/build/
/bin/
/export/

# OS / editor noise
.DS_Store
Thumbs.db
*~
