; Tokyo Dream Circuit - Godot 4 project configuration.
;
; Hand-written rather than generated by the editor, because there is no Godot
; editor for Android. See README.md for what that means for fidelity.
;
; Deliberately has no [input] section: the driving controls are read directly in
; tdc_input.gd, so there is nothing here to break when Godot changes the
; serialised form of an InputEvent. See README.md, "Why there is no InputMap".

config_version=5

[application]

config/name="Tokyo Dream Circuit"
config/description="Procedural highway racing. Wet-grip car physics, SDFGI lighting, cinematic rendering."
run/main_scene="res://scenes/tokyo_night_run.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[physics]

3d/default_gravity=9.81
3d/default_linear_damp=0.0
3d/default_angular_damp=0.05
common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.012, 0.016, 0.03, 1)
